class_name TinyText
extends RefCounted
## A 3×5 bitmap font for labels that must be smaller than Press Start's 8 px:
## yardages on flags, chain counters. Draws with rects so it is always crisp.

const GLYPHS := {
	"0": ["111", "101", "101", "101", "111"], "1": ["010", "110", "010", "010", "111"],
	"2": ["111", "001", "111", "100", "111"], "3": ["111", "001", "011", "001", "111"],
	"4": ["101", "101", "111", "001", "001"], "5": ["111", "100", "111", "001", "111"],
	"6": ["111", "100", "111", "101", "111"], "7": ["111", "001", "010", "010", "010"],
	"8": ["111", "101", "111", "101", "111"], "9": ["111", "101", "111", "001", "111"],
	"A": ["010", "101", "111", "101", "101"], "B": ["110", "101", "110", "101", "110"],
	"C": ["011", "100", "100", "100", "011"], "D": ["110", "101", "101", "101", "110"],
	"E": ["111", "100", "110", "100", "111"], "F": ["111", "100", "110", "100", "100"],
	"G": ["011", "100", "101", "101", "011"], "H": ["101", "101", "111", "101", "101"],
	"I": ["111", "010", "010", "010", "111"], "J": ["001", "001", "001", "101", "010"],
	"K": ["101", "101", "110", "101", "101"], "L": ["100", "100", "100", "100", "111"],
	"M": ["101", "111", "111", "101", "101"], "N": ["110", "101", "101", "101", "101"],
	"O": ["010", "101", "101", "101", "010"], "P": ["110", "101", "110", "100", "100"],
	"Q": ["010", "101", "101", "110", "011"], "R": ["110", "101", "110", "101", "101"],
	"S": ["011", "100", "010", "001", "110"], "T": ["111", "010", "010", "010", "010"],
	"U": ["101", "101", "101", "101", "111"], "V": ["101", "101", "101", "101", "010"],
	"W": ["101", "101", "111", "111", "101"], "X": ["101", "101", "010", "101", "101"],
	"Y": ["101", "101", "010", "010", "010"], "Z": ["111", "001", "010", "100", "111"],
	".": ["000", "000", "000", "000", "010"], ",": ["000", "000", "000", "010", "100"],
	"x": ["000", "101", "010", "101", "000"], "+": ["000", "010", "111", "010", "000"],
	"-": ["000", "000", "111", "000", "000"], "$": ["011", "110", "010", "011", "110"],
	"%": ["101", "001", "010", "100", "101"], "/": ["001", "001", "010", "100", "100"],
	"'": ["010", "010", "000", "000", "000"], "!": ["010", "010", "010", "000", "010"],
	"?": ["110", "001", "010", "000", "010"], ":": ["000", "010", "000", "010", "000"],
	" ": ["000", "000", "000", "000", "000"],
}


static func width(text: String) -> int:
	return maxi(text.length() * 4 - 1, 0)


## pos is the top-left. shadow draws a 1px drop outline for legibility.
static func draw(ci: CanvasItem, pos: Vector2, text: String, color: Color, shadow: Color = Color(0, 0, 0, 0)) -> void:
	var p := pos.floor()
	if shadow.a > 0.0:
		for o in [Vector2(1, 0), Vector2(-1, 0), Vector2(0, 1), Vector2(0, -1), Vector2(1, 1)]:
			_draw_raw(ci, p + o, text, shadow)
	_draw_raw(ci, p, text, color)


static func _draw_raw(ci: CanvasItem, p: Vector2, text: String, color: Color) -> void:
	var x := 0
	for ch in text:
		var g: Array = GLYPHS.get(ch, GLYPHS.get(ch.to_upper(), GLYPHS[" "]))
		for gy in 5:
			var row: String = g[gy]
			for gx in 3:
				if row[gx] == "1":
					ci.draw_rect(Rect2(p + Vector2(x + gx, gy), Vector2.ONE), color)
		x += 4
