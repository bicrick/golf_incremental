[gd_scene load_steps=4 format=3 uid="uid://hud_scene"]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_script"]
[ext_resource type="PackedScene" uid="uid://helper_toggle_chip_scene" path="res://scenes/ui/helper_toggle_chip.tscn" id="2_chip"]
[ext_resource type="Script" path="res://scripts/ui/income_stack.gd" id="3_income_stack"]

[node name="HUD" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 0
offset_left = 10.0
offset_top = 10.0
grow_horizontal = 0
grow_vertical = 0

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TopRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CurrencyPanel" type="PanelContainer" parent="Margin/VBox/TopRow"]
layout_mode = 2
size_flags_vertical = 4

[node name="CurrencyLabel" type="Label" parent="Margin/VBox/TopRow/CurrencyPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 0.98, 1)
theme_override_colors/font_outline_color = Color(0.2, 0.15, 0.1, 0.8)
theme_override_constants/outline_size = 1
theme_override_font_sizes/font_size = 12
text = "$0"

[node name="RatinaChip" parent="Margin/VBox/TopRow" instance=ExtResource("2_chip")]
layout_mode = 2
helper_id = "ratina"

[node name="RattlingChip" parent="Margin/VBox/TopRow" instance=ExtResource("2_chip")]
layout_mode = 2
helper_id = "rattlings"

[node name="IncomeStack" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 1
mouse_filter = 2
script = ExtResource("3_income_stack")
