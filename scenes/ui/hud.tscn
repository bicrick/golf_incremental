[gd_scene load_steps=2 format=3 uid="uid://hud_scene"]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_script"]

[node name="HUD" type="CanvasLayer"]
layer = 1
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 0
offset_left = 8.0
offset_top = 40.0
offset_right = 200.0
offset_bottom = 88.0
theme_override_constants/margin_left = 0
theme_override_constants/margin_top = 0

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="CurrencyLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.9, 0.75, 1)
theme_override_colors/font_outline_color = Color(0.2, 0.15, 0.1, 0.8)
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 18
text = "$0"

[node name="ComboLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.7, 1)
theme_override_colors/font_outline_color = Color(0.2, 0.15, 0.1, 0.6)
theme_override_constants/outline_size = 1
theme_override_font_sizes/font_size = 12
text = "Combo: 0"

[node name="HintLabel" type="Label" parent="Margin/VBox"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.92, 0.45, 1)
theme_override_colors/font_outline_color = Color(0.2, 0.15, 0.1, 0.8)
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 16
text = "Strike!"
