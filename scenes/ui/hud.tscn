[gd_scene load_steps=2 format=3 uid="uid://hud_scene"]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_script"]

[node name="HUD" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 0
offset_left = 10.0
offset_top = 10.0
grow_horizontal = 0
grow_vertical = 0

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CurrencyPanel" type="PanelContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="CurrencyLabel" type="Label" parent="Margin/VBox/CurrencyPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 0.98, 1)
theme_override_colors/font_outline_color = Color(0.2, 0.15, 0.1, 0.8)
theme_override_constants/outline_size = 1
theme_override_font_sizes/font_size = 12
text = "$0"

[node name="RattlingIncomeLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 14)
theme_override_colors/font_color = Color(1.0, 0.88, 0.25, 1)
theme_override_colors/font_outline_color = Color(0.2, 0.15, 0.1, 0.8)
theme_override_constants/outline_size = 1
theme_override_font_sizes/font_size = 10
text = ""
horizontal_alignment = 0
