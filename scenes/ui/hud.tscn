[gd_scene load_steps=2 format=3 uid="uid://hud_scene"]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_script"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 0
offset_right = 200.0
offset_bottom = 80.0
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="CurrencyLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.9, 0.75, 1)
theme_override_font_sizes/font_size = 18
text = "$0"

[node name="ComboLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.7, 1)
theme_override_font_sizes/font_size = 12
text = "Combo: 0"
